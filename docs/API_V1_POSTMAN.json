{"info":{"description":"Item Manager API v1 (Sanctum token auth). Run Login first: it saves the token to the {{token}} collection variable, and every other request sends it as a Bearer token. Base URL is {{base_url}}, default https://item-manager.thephoneboss.net. Full guide: docs/API.md. OpenAPI spec: docs/API_V1_OPENAPI.yaml.","name":"Item Manager API v1","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},"item":[{"item":[{"event":[{"listen":"test","script":{"exec":["if (pm.response.code === 200) {","    var json = pm.response.json();","    if (json.token) {","        pm.collectionVariables.set(\"token\", json.token);","    }","}"],"type":"text/javascript"}}],"name":"Login","request":{"body":{"mode":"raw","raw":"{\n  \"login\": \"miki\",\n  \"password\": \"secret\"\n}"},"description":"Log in with a username or email plus password. Saves the returned token to {{token}}.","header":[{"key":"Content-Type","value":"application/json"},{"key":"Accept","value":"application/json"}],"method":"POST","url":{"host":["{{base_url}}"],"path":["api","v1","login"],"raw":"{{base_url}}/api/v1/login"}}},{"name":"Logout","request":{"description":"Revoke the current token.","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Accept","value":"application/json"}],"method":"POST","url":{"host":["{{base_url}}"],"path":["api","v1","logout"],"raw":"{{base_url}}/api/v1/logout"}}},{"name":"Get User","request":{"description":"The signed-in user.","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Accept","value":"application/json"}],"method":"GET","url":{"host":["{{base_url}}"],"path":["api","v1","user"],"raw":"{{base_url}}/api/v1/user"}}}],"name":"Auth"},{"item":[{"name":"Get Dashboard","request":{"description":"Counts and amounts for the signed-in user. A technician only sees their own assigned orders.","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Accept","value":"application/json"}],"method":"GET","url":{